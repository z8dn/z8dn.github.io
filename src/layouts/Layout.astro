---
import '@/styles/global.css'
import '@/styles/typography.css'

import BoardGround from '@/components/BoardGround.astro'
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex min-h-screen flex-col font-sans">
    {/* reading pages get the board ground; the home page keeps its tiled one */}
    {Astro.url.pathname !== '/' && <BoardGround />}
    <header class="bg-background/90 sticky top-0 z-50 backdrop-blur-sm">
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      class={cn(
        'mx-auto flex w-full max-w-[72rem] grow flex-col gap-y-8 px-5 pt-8 pb-16 sm:px-8 sm:pt-12 sm:pb-24',
        className,
      )}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
