---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/Layout.astro'
import { cn } from '@/lib/utils'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="404" />
  <Breadcrumbs items={[{ label: '???', icon: 'lucide:circle-help' }]} />

  <section
    class="flex flex-col items-center justify-center gap-y-4 text-center"
  >
    <div class="max-w-md">
      <p class="font-pixel text-destructive mb-6 text-2xl sm:text-3xl">
        GAME OVER
      </p>
      <h1 class="font-pixel mb-4 text-sm">ERROR 404: PAGE NOT FOUND</h1>
      <p class="prose">
        The princess is in another castle. This page doesn't exist — but your
        adventure can continue.
      </p>
    </div>
    <Link
      href="/"
      class={cn(
        buttonVariants({ variant: 'outline' }),
        'pixel-card font-pixel group flex gap-x-1.5 text-[0.6rem] uppercase',
      )}
    >
      <span class="transition-transform group-hover:-translate-x-1"
        >&larr;</span
      > Continue?
    </Link>
    <p class="font-pixel text-muted-foreground/60 text-[0.55rem]">
      CREDITS: 0 &nbsp;·&nbsp; INSERT COIN
    </p>
  </section>
</Layout>
