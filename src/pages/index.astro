---
import { Icon } from 'astro-icon/components'
import Logo from '@/components/Logo.astro'
import PageHead from '@/components/PageHead.astro'
import BoardTile from '@/components/tiles/BoardTile.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts, getRecentPosts } from '@/lib/data-utils'
import { SOCIAL_LINKS } from '@/consts'
import GradleDemo from '@/stageshow/gradle/GradleDemo'
import PhoneDemo from '@/stageshow/phone/PhoneDemo'
import fs from 'node:fs'
import path from 'node:path'
import { Image } from 'astro:assets'
import hclLogo from '@/assets/logos/hcltech.jpg'
import anzLogo from '@/assets/logos/anz-plus.png'
import naverLogo from '@/assets/logos/naver.png'
import splusLogo from '@/assets/logos/splus.png'
import slide1 from '@/assets/plugin/slide-1.png'
import slide2 from '@/assets/plugin/slide-2.png'
import slide3 from '@/assets/plugin/slide-3.png'
import slide4 from '@/assets/plugin/slide-4.png'
import slide5 from '@/assets/plugin/slide-5.png'
import '@/styles/bento.css'

const [latest] = await getRecentPosts(1)
const allPosts = await getAllPosts()
const gradlePost =
  allPosts.find((p) => p.id === 'gradle-internals') ??
  allPosts.find((p) => p.data.tags?.includes('gradle')) ??
  null

const PLUGIN_GITHUB = 'https://github.com/z8dn/advanced-android-project-view'
const PLUGIN_MARKET =
  'https://plugins.jetbrains.com/plugin/29829-advanced-android-project-tree'

// Build-time star count, with a fallback when GitHub is unreachable.
let stars = 4
try {
  const r = await fetch(
    'https://api.github.com/repos/z8dn/advanced-android-project-view',
    {
      headers: { Accept: 'application/vnd.github+json' },
      signal: AbortSignal.timeout(4000),
    },
  )
  if (r.ok) {
    const d = await r.json()
    if (typeof d.stargazers_count === 'number') stars = d.stargazers_count
  }
} catch {
  /* use fallback */
}

// Build-time Marketplace download count, with a fallback when the API is unreachable.
let downloads = 1102
try {
  const r = await fetch('https://plugins.jetbrains.com/api/plugins/29829', {
    signal: AbortSignal.timeout(4000),
  })
  if (r.ok) {
    const d = await r.json()
    if (typeof d.downloads === 'number') downloads = d.downloads
  }
} catch {
  /* use fallback */
}

// GitHub contributions from both accounts, read at build time and merged by date.
// The last good result is saved to src/data so a slow or down API never blanks the tile.
const GH_CACHE = path.join(process.cwd(), 'src/data/gh-contributions.json')
let merged = new Map<string, number>()
let ghFetched = true
// Read GitHub's own contribution calendar for each account: every day cell
// carries its date, and a tooltip keyed to the cell carries the count.
for (const user of ['z8dn', 'z8dn-anz']) {
  try {
    const r = await fetch(`https://github.com/users/${user}/contributions`, {
      headers: { 'User-Agent': 'z8dn-site-build' },
      signal: AbortSignal.timeout(10000),
    })
    if (!r.ok) throw new Error(String(r.status))
    const html = await r.text()
    const dateById = new Map<string, string>()
    for (const [td] of html.matchAll(/<td[^>]*ContributionCalendar-day[^>]*>/g)) {
      const id = td.match(/\bid=\x22([^\x22]+)\x22/)?.[1]
      const date = td.match(/data-date=\x22([^\x22]+)\x22/)?.[1]
      if (id && date) dateById.set(id, date)
    }
    if (!dateById.size) throw new Error('no calendar cells')
    for (const [, id, text] of html.matchAll(
      /<tool-tip[^>]*\bfor=\x22([^\x22]+)\x22[^>]*>\s*([^<]*)/g,
    )) {
      const date = dateById.get(id)
      const n = Number(text.match(/^([\d,]+) contribution/)?.[1]?.replace(/,/g, ''))
      if (date && n > 0) merged.set(date, (merged.get(date) ?? 0) + n)
    }
  } catch {
    ghFetched = false
  }
}
if (ghFetched) {
  // Write only in production builds and only when changed (avoids a dev reload loop).
  try {
    const next = JSON.stringify(Object.fromEntries(merged))
    const prev = fs.existsSync(GH_CACHE) ? fs.readFileSync(GH_CACHE, 'utf8') : ''
    if (!import.meta.env.DEV && next !== prev) {
      fs.mkdirSync(path.dirname(GH_CACHE), { recursive: true })
      fs.writeFileSync(GH_CACHE, next)
    }
  } catch {
    /* cache is best-effort */
  }
} else {
  try {
    merged = new Map(Object.entries(JSON.parse(fs.readFileSync(GH_CACHE, 'utf8'))))
    ghFetched = true
  } catch {
    merged = new Map()
  }
}
const ghTotal = [...merged.values()].reduce((s, n) => s + n, 0)

// Heatmap: Sunday-aligned columns, the last WEEKS weeks, UTC date math.
const WEEKS = 26
const nonZero = [...merged.values()].filter((n) => n > 0).sort((a, b) => a - b)
const q = (p: number) => nonZero[Math.floor(nonZero.length * p)] ?? 1
const [t1, t2, t3] = [q(0.25), q(0.5), q(0.75)]
const level = (n: number) =>
  !n ? 0 : n <= t1 ? 1 : n <= t2 ? 2 : n <= t3 ? 3 : 4
const now = new Date()
const todayUtc = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate())
const DAY = 86400000
const start = todayUtc - now.getUTCDay() * DAY - (WEEKS - 1) * 7 * DAY
const cells = ghFetched
  ? Array.from({ length: WEEKS * 7 }, (_, i) => {
      const t = start + i * DAY
      const date = new Date(t).toISOString().slice(0, 10)
      const n = merged.get(date) ?? 0
      return { date, n, lvl: level(n), future: t > todayUtc }
    })
  : Array.from({ length: WEEKS * 7 }, (_, i) => ({
      date: '',
      n: 0,
      lvl: 0,
      future: false,
    }))

const career: {
  years: string
  role: string
  where: string
  icon?: string
  image?: ImageMetadata
  linked?: boolean
  self?: boolean
}[] = [
  {
    years: '2025 – now',
    role: 'Technical Lead',
    where: 'HCLTech',
    image: hclLogo,
  },
  {
    years: '2025 – now',
    role: 'Senior Software Engineer',
    where: 'ANZ Plus · contract, via HCLTech',
    image: anzLogo,
    linked: true,
  },
  {
    years: '2023 – 2025',
    role: 'Senior Android Engineer',
    where: 'NAVER Vietnam',
    image: naverLogo,
  },
  {
    years: '2018 – 2023',
    role: 'Mobile Engineer',
    where: 'Freelance · clients in Japan, remote',
    self: true,
  },
  {
    years: '2017 – 2018',
    role: 'Software Engineer',
    where: 'Splus-Software',
    image: splusLogo,
  },
]

const stack = [
  { name: 'Kotlin', icon: 'simple-icons:kotlin' },
  { name: 'Android', icon: 'simple-icons:android' },
  { name: 'Gradle', icon: 'simple-icons:gradle' },
  { name: 'Compose', icon: 'simple-icons:jetpackcompose' },
  { name: 'IntelliJ SDK', icon: 'simple-icons:intellijidea' },
  { name: 'Claude', icon: 'simple-icons:claude' },
]

const email = SOCIAL_LINKS.find((l) => l.label === 'Email')
const emailAddress = email?.href.replace('mailto:', '') ?? ''
const contactLinks = SOCIAL_LINKS.filter((l) =>
  ['LinkedIn', 'Medium', 'RSS'].includes(l.label),
)
const fmt = (d: Date) => d.toISOString().slice(0, 10)

const pluginSlides = [
  { src: slide1, alt: 'The files Android view hides, one click away: build outputs and project files in the Android project tree' },
  { src: slide2, alt: 'Show build/ inside every module, from the Display Build Directory option' },
  { src: slide3, alt: 'See what a pattern matches before you save it, in the custom file group editor' },
  { src: slide4, alt: 'Search inside a group: every file group is a scope in Find in Files' },
  { src: slide5, alt: 'Group the files you keep reaching for, in the plugin settings' },
]
---

<Layout>
  <PageHead
    slot="head"
    title="z8dn"
    description="Zayden (z8dn): Android engineer in Ho Chi Minh City. Production banking apps, Android Studio tooling, and writing about Gradle build performance."
  />

  <h1 class="sr-only">Zayden — Android engineer</h1>

  <div class="bento-wrap">
    <div class="bento">
      <!-- Intro -->
      <section class="tile t-intro">
        <span class="hw hw--screws hw--ticks-b" data-part="Z8-01" aria-hidden="true"></span>
        <div class="intro-head">
          <span class="intro-name"
            ><Logo size={36} /><span class="wordmark">z8dn</span></span
          >
          <span class="intro-hello">Xin chào · 你好 · Hello</span>
        </div>
        <p class="intro-lede">
          I'm Zayden, a Chinese-Vietnamese engineer in Ho Chi Minh City. I
          build Android apps and the tools that build them.
        </p>
        <p class="intro-sub">
          Technical Lead at HCLTech, on the Access &amp; Protect mobile team for the ANZ Plus banking app.
        </p>
        <p class="intro-links">
          <a class="link-quiet" href="/work">Work</a>
          <a class="link-quiet" href="/blog">Blog</a>
        </p>
      </section>

      <!-- Here -->
      <section class="tile t-here">
        <span class="hw" data-part="Z8-02" aria-hidden="true"></span>
        <p class="eyebrow">Here</p>
        <div class="here-body">
          <p class="here-clock">
            <time id="hcm-clock" datetime=""
              ><span id="hcm-h">--</span><span class="colon">:</span><span
                id="hcm-m">--</span
              ></time
            >
          </p>
          <p class="here-place">Ho Chi Minh City</p>
          <p class="here-tz">UTC+7</p>
        </div>
      </section>

      <!-- Phone -->
      <section class="tile tile--bleed t-phone">
        <span class="hw hw--screws" data-part="Z8-03" aria-hidden="true"></span>
        <div class="tile-head">
          <p class="eyebrow">Day job</p>
          <p class="tile-caption">ANZ Plus · selfie capture and digital registration</p>
        </div>
        <div class="demo-area demo-area--phone" style="--r: 0.584">
          <div class="demo-box">
            <PhoneDemo client:idle />
          </div>
        </div>
      </section>

      <!-- Plugin -->
      <section class="tile tile--bleed t-plugin">
        <span class="hw hw--screws hw--ticks-r" data-part="Z8-04" aria-hidden="true"></span>
        <div class="carousel" data-carousel aria-roledescription="carousel" aria-label="Advanced Android Project Tree screenshots">
          <ul class="carousel-track" data-track tabindex="0">
            {
              pluginSlides.map((sl, i) => (
                <li class="carousel-slide" aria-label={`${i + 1} of ${pluginSlides.length}`}>
                  <Image
                    src={sl.src}
                    alt={sl.alt}
                    widths={[640, 1280, 1920]}
                    sizes="(min-width: 1024px) 580px, 100vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </li>
              ))
            }
          </ul>
          <button class="carousel-btn carousel-btn--prev" data-prev type="button" aria-label="Previous screenshot">
            <Icon name="lucide:chevron-left" />
          </button>
          <button class="carousel-btn carousel-btn--next" data-next type="button" aria-label="Next screenshot">
            <Icon name="lucide:chevron-right" />
          </button>
          <div class="carousel-dots" data-dots aria-hidden="true">
            {pluginSlides.map((_, i) => <span class:list={{ on: i === 0 }} />)}
          </div>
        </div>
        <div class="plugin-copy">
          <p class="eyebrow">Open source</p>
          <div class="plugin-title">
            <h2>Advanced Android Project Tree</h2>
          </div>
          <p class="plugin-stats">
            <span
              ><strong>{downloads.toLocaleString('en-US')}</strong> downloads</span
            >
            <span aria-label={`${stars} GitHub stars`}
              ><strong>★ {stars}</strong> on GitHub</span
            >
          </p>
          <p class="plugin-desc">
            An Android Studio plugin that adds quick access to commonly used
            directories and files in the project view.
          </p>
          <p class="plugin-links">
            <a class="link-quiet" href={PLUGIN_GITHUB} rel="noopener">GitHub</a>
            <a class="link-quiet" href={PLUGIN_MARKET} rel="noopener"
              >Marketplace</a
            >
          </p>
        </div>
      </section>

      <!-- Pattern A -->
      <div class="tile tile--bare t-pata" aria-hidden="true">
        <BoardTile variant="panel" />
      </div>

      <!-- Build -->
      {
        gradlePost ? (
          <a
            class="tile tile--bleed tile--link t-build"
            href={`/blog/${gradlePost.id}`}
            aria-label={`Build time: ${gradlePost.data.title}`}
          >
            <span class="hw" data-part="Z8-06" aria-hidden="true"></span>
            <div class="tile-head">
              <p class="eyebrow">Build time</p>
            </div>
            <div class="demo-area demo-area--build" style="--r: 1.186">
              <div class="demo-box">
                <GradleDemo client:idle />
              </div>
            </div>
            <span class="arrow" aria-hidden="true">
              <Icon name="lucide:arrow-up-right" size={16} />
            </span>
          </a>
        ) : (
          <section class="tile tile--bleed t-build">
            <span class="hw" data-part="Z8-06" aria-hidden="true"></span>
            <div class="tile-head">
              <p class="eyebrow">Build time</p>
            </div>
            <div class="demo-area demo-area--build" style="--r: 1.186">
              <div class="demo-box">
                <GradleDemo client:idle />
              </div>
            </div>
          </section>
        )
      }

      <!-- Career -->
      <section class="tile t-career">
        <span class="hw hw--screws hw--ticks-r" data-part="Z8-07" aria-hidden="true"></span>
        <p class="eyebrow">Career</p>
        <ol class="career">
          {
            career.map((c, i) => (
              <li class:list={['career-row', { 'career-row--linked': c.linked }]}>
                <span class:list={['career-logo', { 'career-logo--self': c.self }]} aria-hidden="true">
                  {c.image ? (
                    <Image src={c.image} alt="" width={56} height={56} />
                  ) : (
                    c.self ? <Logo size={28} /> : c.icon && <Icon name={c.icon} />
                  )}
                </span>
                <span class="career-years">
                  {c.years.endsWith('now') && <span class="now-dot" aria-hidden="true" />}
                  {c.years}
                </span>
                <span class="career-role">{c.role}</span>
                <span class="career-where">{c.where}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Activity -->
      <section class="tile t-activity">
        <span class="hw hw--screws" data-part="Z8-08" aria-hidden="true"></span>
        <div class="activity-head">
          <p class="eyebrow">GitHub activity</p>
          {
            ghFetched && (
              <p class="activity-total">
                {ghTotal.toLocaleString('en-US')}
                <span> in the last year</span>
              </p>
            )
          }
        </div>
        <div class="heat" role="img" aria-label={ghFetched ? `${ghTotal} GitHub contributions in the last year` : 'GitHub activity unavailable'}>
          {
            cells.map((c) => (
              <i
                class="heat-cell"
                data-l={c.lvl}
                data-future={c.future ? '' : undefined}
                title={c.date ? `${c.date} · ${c.n}` : undefined}
              />
            ))
          }
        </div>
      </section>

      <!-- Stack: the tools as parts on a board -->
      <section class="tile t-patb t-stack">
        <span class="hw" data-part="Z8-09" aria-hidden="true"></span>
        <p class="eyebrow">Stack</p>
        <div class="stack-board">
          <svg class="stack-traces" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M50 4V96" />
            <path d="M38 17H62" />
            <path d="M38 50H62" />
            <path d="M38 83H62" />
          </svg>
          <ul class="stack-chips">
            {
              stack.map((t) => (
                <li class="stack-chip" title={t.name}>
                  <Icon name={t.icon} aria-hidden="true" />
                  <span>{t.name}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Post -->
      {
        latest && (
          <a class="tile tile--link t-post" href={`/blog/${latest.id}`}>
        <span class="hw hw--screws hw--ticks-r" data-part="Z8-10" aria-hidden="true"></span>
            <p class="eyebrow">Latest post</p>
            <div class="post-body">
              <time class="post-date" datetime={fmt(latest.data.date)}>
                {fmt(latest.data.date)}
              </time>
              <h2 class="post-title">{latest.data.title}</h2>
              <p class="post-desc">{latest.data.description}</p>
            </div>
            <span class="arrow" aria-hidden="true">
              <Icon name="lucide:arrow-up-right" size={16} />
            </span>
          </a>
        )
      }

      <!-- GitHub -->
      <a
        class="tile tile--link t-github"
        href="https://github.com/z8dn"
        rel="noopener"
        aria-label="z8dn on GitHub"
      >
        <span class="hw" data-part="Z8-11" aria-hidden="true"></span>
        <span class="gh-mark" aria-hidden="true">
          <Icon name="simple-icons:github" />
        </span>
        <span class="gh-handle">@z8dn</span>
        <span class="arrow" aria-hidden="true">
          <Icon name="lucide:arrow-up-right" size={16} />
        </span>
      </a>

      <!-- Contact -->
      <section class="tile t-contact">
        <span class="hw" data-part="Z8-12" aria-hidden="true"></span>
        <p class="eyebrow">Say hello</p>
        {
          email && (
            <a class="contact-email link-quiet" href={email.href}>
              {emailAddress}
            </a>
          )
        }
        <ul class="contact-links">
          {
            contactLinks.map((l) => (
              <li>
                <a
                  class="link-quiet"
                  href={l.href}
                  rel={l.href.startsWith('http') ? 'noopener' : undefined}
                  >{l.label}</a
                >
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Layout>

<script is:inline>
  ;(function () {
    function tick() {
      var el = document.getElementById('hcm-clock')
      if (!el) return
      var now = new Date()
      var parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Ho_Chi_Minh',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(now)
      var h = '--'
      var m = '--'
      parts.forEach(function (p) {
        if (p.type === 'hour') h = p.value === '24' ? '00' : p.value
        if (p.type === 'minute') m = p.value
      })
      var hEl = document.getElementById('hcm-h')
      var mEl = document.getElementById('hcm-m')
      if (hEl) hEl.textContent = h
      if (mEl) mEl.textContent = m
      el.setAttribute('datetime', now.toISOString())
    }
    window.__hcmTick = tick
    if (!window.__hcmClockInit) {
      window.__hcmClockInit = true
      setInterval(function () {
        window.__hcmTick && window.__hcmTick()
      }, 15000)
      document.addEventListener('astro:page-load', tick)
    }
    tick()
  })()
</script>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      if (root.dataset.ready) return
      root.dataset.ready = '1'
      const track = root.querySelector<HTMLElement>('[data-track]')!
      const dots = [...root.querySelectorAll<HTMLElement>('[data-dots] span')]
      const index = () => Math.round(track.scrollLeft / track.clientWidth)
      const go = (i: number) => {
        const n = dots.length
        track.scrollTo({ left: ((i + n) % n) * track.clientWidth })
      }
      root.querySelector('[data-prev]')?.addEventListener('click', () => go(index() - 1))
      root.querySelector('[data-next]')?.addEventListener('click', () => go(index() + 1))
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') go(index() - 1)
        if (e.key === 'ArrowRight') go(index() + 1)
      })
      track.addEventListener(
        'scroll',
        () => dots.forEach((d, i) => d.classList.toggle('on', i === index())),
        { passive: true },
      )
    })
  }
  document.addEventListener('astro:page-load', initCarousels)
  initCarousels()
</script>
