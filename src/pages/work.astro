---
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'

const projects = await getAllProjects()
---

<Layout>
  <PageHead
    slot="head"
    title="Work"
    description="Production Android at scale, build tooling, and open source by Zayden (z8dn)."
  />

  <header class="flex flex-col gap-4 pb-6">
    <h1 class="page-title">Work</h1>
    <p class="text-muted-foreground max-w-[56ch] text-lg leading-relaxed">
      I lead Android engineering on a production banking app, and build the
      tools that keep large Gradle projects fast.
    </p>
  </header>

  <section aria-label="Projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</Layout>
