---
import Link from '@/components/Link.astro'
import { cn } from '@/lib/utils'

const { newerPost, olderPost, parentPost } = Astro.props
const isSubpost = !!parentPost

const item =
  'group flex flex-col gap-1 py-5 transition-colors hover:text-accent'
const disabled = 'pointer-events-none opacity-40'
---

<nav
  aria-label="Post navigation"
  class={cn(
    'rule col-start-2 grid grid-cols-1 gap-x-8 sm:divide-x-0',
    isSubpost ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
  )}
>
  <Link
    href={olderPost ? `/blog/${olderPost.id}#post-title` : '#'}
    class={cn(item, 'items-start', !olderPost && disabled)}
    aria-disabled={!olderPost}
  >
    <span class="eyebrow">
      {isSubpost ? 'Previous part' : 'Older'}
    </span>
    <span class="text-sm text-balance">
      {
        olderPost?.data.title ||
          (isSubpost ? 'No older part' : "You're at the oldest post")
      }
    </span>
  </Link>

  {
    isSubpost && (
      <Link
        href={parentPost ? `/blog/${parentPost.id}#post-title` : '#'}
        class={cn(item, 'items-start sm:items-center sm:text-center', !parentPost && disabled)}
      >
        <span class="eyebrow">Series</span>
        <span class="text-sm text-balance">
          {parentPost?.data.title || 'No parent post'}
        </span>
      </Link>
    )
  }

  <Link
    href={newerPost ? `/blog/${newerPost.id}#post-title` : '#'}
    class={cn(item, 'items-start sm:items-end sm:text-right', !newerPost && disabled)}
    aria-disabled={!newerPost}
  >
    <span class="eyebrow">
      {isSubpost ? 'Next part' : 'Newer'}
    </span>
    <span class="text-sm text-balance">
      {
        newerPost?.data.title ||
          (isSubpost ? 'No newer part' : "You're at the newest post")
      }
    </span>
  </Link>
</nav>
