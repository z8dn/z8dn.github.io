---
import { Badge } from '@/components/ui/badge'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<article class="rule group py-8 first:border-t-0 first:pt-0">
  <div class="grid gap-3 md:grid-cols-[15rem_1fr] md:gap-8">
    <p class="eyebrow md:pt-2">
      <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true"> · </span>{readTime}
    </p>
    <div class="flex flex-col gap-3">
      <h3 class="text-2xl leading-tight sm:text-3xl">
        <Link
          href={`/${entry.collection}/${entry.id}`}
          class="hover:text-accent block transition-colors"
        >
          {entry.data.title}
        </Link>
      </h3>
      <p class="text-muted-foreground max-w-[60ch] leading-relaxed">
        {entry.data.description}
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          entry.data.tags?.map((tag) => (
            <Badge variant="muted">#{tag}</Badge>
          ))
        }
        {
          subpostCount > 0 && (
            <span class="text-muted-foreground dot text-xs">
              {subpostCount} part{subpostCount === 1 ? '' : 's'}
            </span>
          )
        }
      </div>
    </div>
  </div>
</article>
