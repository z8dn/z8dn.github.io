---
import Link from './Link.astro'
import { Icon } from 'astro-icon/components'
---

<footer
  class="mx-auto mb-8 flex w-full max-w-3xl flex-col items-center justify-center gap-y-2 px-4 sm:mb-4"
>
  <p
    class="font-pixel text-muted-foreground/70 text-[0.55rem] tracking-wider uppercase"
  >
    ★ Insert coin to continue ★
  </p>
  <div class="flex flex-wrap items-center justify-center gap-x-2">
    <span class="text-muted-foreground text-sm">
      &copy; {new Date().getFullYear()} z8dn
    </span>
    <span class="text-muted-foreground/40 text-sm" aria-hidden="true">·</span>
    <p class="text-muted-foreground text-sm">
      Made with <a
        href="https://claude.ai"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Claude"
        class="text-muted-foreground hover:text-foreground mx-0.5 inline-flex items-center align-middle transition-colors"
        ><Icon name="simple-icons:claude" class="size-[0.85rem]" /></a
      > by <Link href="https://github.com/z8dn" class="text-foreground" external underline
        >z8dn</Link
      >
    </p>
  </div>
  <p class="text-muted-foreground/50 font-mono text-[0.65rem]">
    psst… try ↑ ↑ ↓ ↓ ← → ← → B A
  </p>
</footer>
