---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { NAV_LINKS, SITE } from '@/consts'

const path = Astro.url.pathname
---

<div class="border-border border-b">
  <div
    class="mx-auto flex h-14 w-full max-w-[72rem] items-center justify-between gap-4 px-5 sm:px-8"
  >
    <Link
      href="/"
      class="flex shrink-0 items-center gap-2.5"
      aria-label={`${SITE.title} home`}
    >
      <span class="seal" aria-hidden="true">z8</span>
      <span class="text-[1.125rem] font-semibold tracking-tight">{SITE.title}</span>
    </Link>
    <div class="flex items-center gap-5 sm:gap-7">
      <nav class="flex items-center gap-5 sm:gap-7" aria-label="Primary">
        {
          NAV_LINKS.map((item) => {
            const active = path === item.href || path.startsWith(item.href + '/')
            return (
              <Link
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class={
                  'text-sm underline decoration-transparent underline-offset-[6px] transition-colors hover:decoration-current ' +
                  (active
                    ? 'text-foreground decoration-accent'
                    : 'text-muted-foreground hover:text-foreground')
                }
              >
                {item.label}
              </Link>
            )
          })
        }
      </nav>
      <ThemeToggle transition:persist />
    </div>
  </div>
</div>
